# Copy to .env and fill in. NEVER commit .env to git.
# --- brain ---
LLM_PROVIDER=demo            # demo (offline sandbox) | gemini (deploy)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TAVILY_API_KEY=              # optional: better web search (falls back to DuckDuckGo)
# --- safety ---
JARVIS_USER=owner             # login username (only used with JARVIS_PASSWORD)
JARVIS_PASSWORD=             # set to lock the UI with a login (do this on public URLs!)
DAILY_SPEND_CAP_USD=2.0      # max LLM spend per day; 0 disables
# --- misc ---
TIMEZONE=Asia/Kolkata
PORT=8000
